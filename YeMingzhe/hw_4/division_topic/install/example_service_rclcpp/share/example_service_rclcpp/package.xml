  <version>0.0.0</version>
  <description>Service client-server example using custom_interfaces</description>
  
  <maintainer email="yemingzhe3@gmail.com">ymz</maintainer>
  <license>Apache-2.0</license> <!-- 确保声明许可证，如 Apache-2.0 -->

